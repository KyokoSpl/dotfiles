/**
 * Material 3 Expressive Theme - OneDark
 * Inspired by BeerCSS and Material You design language
 * 
 * Features:
 * - Material 3 color system with surface containers
 * - Expressive rounded corners and soft shadows
 * - OneDark color palette adaptation
 */

* {
    /* OneDark Base Colors */
    bg0:                     #1e222a;
    bg1:                     #21252b;
    bg2:                     #282c34;
    bg3:                     #2c323c;
    bg4:                     #3e4451;
    
    /* OneDark Accent Colors */
    primary:                 #61afef;
    primary-container:       #2d4a63;
    on-primary:              #1e222a;
    on-primary-container:    #b4d7f5;
    
    secondary:               #98c379;
    secondary-container:     #3d5235;
    on-secondary:            #1e222a;
    on-secondary-container:  #c8e6b1;
    
    tertiary:                #c678dd;
    tertiary-container:      #4a3355;
    on-tertiary:             #1e222a;
    on-tertiary-container:   #e5c4ed;
    
    error:                   #e06c75;
    error-container:         #5c2f33;
    on-error:                #1e222a;
    on-error-container:      #f0b5ba;
    
    /* OneDark Text Colors */
    fg0:                     #abb2bf;
    fg1:                     #c8cdd5;
    fg2:                     #5c6370;
    
    /* Material 3 Surface Containers - OneDark adapted */
    surface:                 #1e222a;
    surface-dim:             #181a1f;
    surface-bright:          #3e4451;
    surface-container-lowest:#181a1f;
    surface-container-low:   #21252b;
    surface-container:       #282c34;
    surface-container-high:  #2c323c;
    surface-container-highest:#3e4451;
    
    /* OneDark Semantic Colors */
    orange:                  #d19a66;
    yellow:                  #e5c07b;
    cyan:                    #56b6c2;
    
    /* Material 3 Outline */
    outline:                 #5c6370;
    outline-variant:         #3e4451;
    
    /* Inverse */
    inverse-surface:         #abb2bf;
    inverse-on-surface:      #1e222a;
    inverse-primary:         #3a7bb5;
    
    background-color:        @surface;
}

window {
    width:                   680px;
    height:                  520px;
    border:                  0px;
    border-radius:           28px;
    background-color:        @surface;
    padding:                 0px;
    /* Material 3 elevation shadow effect */
}

mainbox {
    spacing:                 0;
    background-color:        transparent;
    children:                [inputbar, message, listview, mode-switcher];
}

inputbar {
    padding:                 16px 24px;
    spacing:                 16px;
    background-color:        @surface-container-low;
    border-radius:           28px 28px 0 0;
    children:                [prompt, entry];
}

prompt {
    padding:                 14px 24px;
    background-color:        @primary;
    text-color:              @on-primary;
    border-radius:           24px;
    font:                    "Iosevka Bold 12";
    vertical-align:          0.5;
    horizontal-align:        0.5;
}

textbox-prompt-colon {
    expand:                  false;
    str:                     "";
    background-color:        transparent;
}

entry {
    padding:                 14px 20px;
    background-color:        @surface-container;
    text-color:              @fg0;
    border-radius:           24px;
    placeholder:             "Search...";
    placeholder-color:       @fg2;
    cursor:                  text;
    vertical-align:          0.5;
}

message {
    padding:                 12px 24px;
    background-color:        @secondary-container;
    border-radius:           0;
}

textbox {
    text-color:              @on-secondary-container;
    background-color:        transparent;
    vertical-align:          0.5;
    horizontal-align:        0;
}

error-message {
    padding:                 24px;
    background-color:        @error-container;
    text-color:              @on-error-container;
    border-radius:           16px;
}

listview {
    columns:                 1;
    lines:                   6;
    padding:                 8px 16px;
    spacing:                 4px;
    fixed-height:            true;
    background-color:        @surface;
    scrollbar:               true;
    border:                  0;
    cycle:                   true;
}

scrollbar {
    width:                   6px;
    padding:                 0;
    handle-width:            6px;
    handle-color:            @outline-variant;
    border-radius:           3px;
    background-color:        @surface-container-lowest;
}

element {
    padding:                 12px 16px;
    spacing:                 16px;
    border-radius:           16px;
    background-color:        transparent;
    cursor:                  pointer;
}

element normal.normal {
    background-color:        transparent;
    text-color:              @fg0;
}

element normal.urgent {
    background-color:        @error-container;
    text-color:              @on-error-container;
}

element normal.active {
    background-color:        @tertiary-container;
    text-color:              @on-tertiary-container;
}

element selected.normal {
    background-color:        @primary-container;
    text-color:              @on-primary-container;
    border:                  0px;
}

element selected.urgent {
    background-color:        @error;
    text-color:              @on-error;
}

element selected.active {
    background-color:        @secondary;
    text-color:              @on-secondary;
}

element alternate.normal {
    background-color:        transparent;
    text-color:              @fg0;
}

element alternate.urgent {
    background-color:        @error-container;
    text-color:              @on-error-container;
}

element alternate.active {
    background-color:        @tertiary-container;
    text-color:              @on-tertiary-container;
}

element-icon {
    size:                    28px;
    cursor:                  inherit;
    background-color:        transparent;
    text-color:              inherit;
    vertical-align:          0.5;
}

element-text {
    cursor:                  inherit;
    background-color:        transparent;
    text-color:              inherit;
    vertical-align:          0.5;
    horizontal-align:        0;
    highlight:               bold underline;
}

mode-switcher {
    spacing:                 8px;
    padding:                 12px 24px 16px 24px;
    background-color:        @surface-container-low;
    border-radius:           0 0 28px 28px;
}

button {
    padding:                 12px 20px;
    background-color:        @surface-container-high;
    text-color:              @fg2;
    border-radius:           20px;
    cursor:                  pointer;
    vertical-align:          0.5;
    horizontal-align:        0.5;
}

button selected {
    background-color:        @primary;
    text-color:              @on-primary;
}
